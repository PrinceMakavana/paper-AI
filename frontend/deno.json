{
  "nodeModulesDir": "manual",
  "unstable": [
    "bare-node-builtins",
    "detect-cjs",
    "node-globals",
    "unsafe-proto",
    "sloppy-imports"
  ],
  "deploy": {
    "framework": "nextjs",
    "prepare" : "node --version && deno clean",
    "install": "deno clean && deno rm -rf node_modules && npm install --ignore-scripts",
    "build": "node --version && rm -rf .next && npm run build"
  }
}
