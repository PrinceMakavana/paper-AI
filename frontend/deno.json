{
  "nodeModulesDir": "manual",
  "unstable": [
    "bare-node-builtins",
    "detect-cjs",
    "node-globals",
    "unsafe-proto",
    "sloppy-imports"
  ],
  "deploy": {
    "framework": "nextjs",
    "install": "rm -rf node_modules deno.lock && npm install --ignore-scripts --legacy-peer-deps",
    "build": "rm -rf .next && deno run -A npm:next build"
  }
}
