    "@langchain/core": "^1.1.43",
    "@langchain/google-genai": "^2.1.30",
    "@langchain/ollama": "^1.2.7",
    "@langchain/pinecone": "^1.0.3",
    "@pageindex/sdk": "^0.8.0",
