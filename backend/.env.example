PORT=3075
FRONTEND_URL=http://localhost:3000
# SMTP (email verification + password reset)
# Emails are never sent when NODE_ENV=test, TAP is set (npm test), or DISABLE_EMAIL=true
# DISABLE_EMAIL=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=PaperAI <your-email@gmail.com>
CONTACT_FROM_EMAIL=your-email@gmail.com
EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=15m
PAGEINDEX_BACKEND_API_URL=http://127.0.0.1:8000
# Shown in Find materials when requested data is not in the catalog
CATALOG_CONTRIBUTE_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSfHD_cTiKkxgR38sxyxO_AIbGX9wTasP6z-KIvmL2JP8eJqtw/viewform
# Flat token charge when catalog find answers locally with links found
LOCAL_CATALOG_FIND_TOKEN_COST=600
# Shared with the Next.js server only. Required for /public/catalog/* API access.
PUBLIC_CATALOG_API_SECRET="abcdefghijklmnopqrstuvwxyz124567890"
MONGODB_URI=""
MONGODB_DB_NAME=""
PINECONE_API_KEY=""
PINECONE_INDEX_NAME=""
# OpenAI
OPENAI_API_KEY=""
# Gemini (up to 5 keys; rotates on quota/rate-limit errors)
GEMINI_API_KEY=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
GEMINI_API_KEY_4=""
GEMINI_API_KEY_5=""
GEMINI_MODEL_NAME="gemini-3.1-flash-lite-preview"
EMBEDDING_MODEL_NAME="gemini-embedding-001"
# Ollama
OLLAMA_API_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL_NAME="nomic-embed-text"
OLLAMA_MODEL_NAME=llama3
# PageIndex API Key
PAGEINDEX_API_KEY=""
# Hosted PageIndex automation (chat + dashboard)
PAGEINDEX_API_URL=https://chat.pageindex.ai
PAGEINDEX_API_DASHBOARD_URL=https://dash.pageindex.ai
# Disposable inbox API for hosted job OTP/reset emails (https://mail.tm)
MAILTM_API_BASE_URL=https://api.mail.tm
# 32-byte key, base64-encoded — encrypts stored PageIndex password/API key
# Generate: npm run generate:secrets-key  (must decode to exactly 32 bytes)
PAGEINDEX_SECRETS_KEY=""
# Temp PDF staging for hosted upload jobs (transient; deleted after PageIndex upload step)
PAGEINDEX_JOB_TEMP_ROOT=
# AWS S3 storage for hosted uploads and PDF viewer signing
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""
AWS_S3_PREFIX=pageindex
PAGEINDEX_S3_BUCKET=pageindex-json-store

PDF_SIGNED_URL_EXPIRES_SECONDS=300
# JWT Secret
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
MAX_FILE_SIZE=10 #in mb
MAX_FILE_PAGE_COUNT=100 #in pages

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
