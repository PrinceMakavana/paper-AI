# GEMINI_API_KEY=""
# MONGODB_URI=""
# MONGODB_DB_NAME="page-index-chatbot"
# OLLAMA_API_URL="http://localhost:11434"
# GEMINI_MODEL_NAME="gemini-3.1-flash-lite-preview"
# OLLAMA_MODEL_NAME="llama3"
# OPENAI_MODEL_NAME="gpt-4o-mini"
# ANTHROPIC_MODEL_NAME="claude-3-5-sonnet-latest"

# AWS S3 Configuration (Required)
# AWS_S3_BUCKET_NAME="your-s3-bucket-name"
# AWS_S3_PREFIX="pageindex"
# AWS_ACCESS_KEY_ID="your-aws-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
# AWS_SESSION_TOKEN=""  # Optional for temporary credentials
# AWS_REGION="us-east-1"

# AWS S3 Timeouts & Retries (Optional - uses defaults if not set)
# S3_UPLOAD_TIMEOUT=30
# S3_DOWNLOAD_TIMEOUT=30
# S3_MAX_RETRIES=3
# S3_RETRY_DELAY=1
